# Optional server-only MySQL connection for self-hosted development. The hosted project injects its managed DATABASE_URL at runtime.
# Never prefix this with VITE_ or expose it in browser code.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
BUILT_IN_FORGE_API_URL=YOUR_ACTUAL_PROVIDER_API_URL
BUILT_IN_FORGE_API_KEY=YOUR_ACTUAL_API_KEY